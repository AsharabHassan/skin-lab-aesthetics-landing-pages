---
import Icon from "./Icon.astro";
import { site, telHref, treatmentNames, webhooks, pageOrder } from "../data/site";
interface Props { slug: string; options?: string[]; title?: string; intro?: string }
const { slug, options, title = "Book Your In-Clinic Consultation", intro } = Astro.props;
const choices = options ?? pageOrder.map((k) => treatmentNames[k]);
const selected = treatmentNames[slug] ?? choices[0];
---
<div id="booking" class="card relative overflow-hidden p-6 shadow-[0_30px_60px_-40px_rgba(20,18,16,.45)] sm:p-8">
  <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-gold-light via-gold to-gold-deep"></div>
  <p class="eyebrow">DHA Phase 4, Lahore</p>
  <h2 class="mt-3 text-[1.75rem] sm:text-3xl">{title}</h2>
  {intro && <p class="mt-2 text-[0.95rem] leading-relaxed text-muted">{intro}</p>}

  <div data-status="error" hidden class="mt-5 rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
    ✗ Something went wrong. Please try again or call us directly on {site.primaryPhone}.
  </div>

  <form id="booking-form" class="mt-6 space-y-4" data-slug={slug} data-endpoint={webhooks[slug] ?? webhooks.dermatology} data-clinic={site.brandName}>
    <div>
      <label for="f-name" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.14em] text-muted">Name</label>
      <input id="f-name" name="name" type="text" required autocomplete="name" placeholder="Your full name" class="field" />
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
      <div>
        <label for="f-phone" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.14em] text-muted">Phone</label>
        <input id="f-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="0325 555 2088" class="field" />
      </div>
      <div>
        <label for="f-email" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.14em] text-muted">Email</label>
        <input id="f-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="field" />
      </div>
    </div>
    <div>
      <label for="f-treatment" class="mb-1.5 block text-xs font-semibold uppercase tracking-[0.14em] text-muted">Treatment Interest</label>
      <select id="f-treatment" name="treatment" class="field appearance-none bg-[url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%228%22><path d=%22M1 1l5 5 5-5%22 fill=%22none%22 stroke=%22%237a5c1e%22 stroke-width=%221.6%22/></svg>')] bg-[length:12px_8px] bg-[position:right_1rem_center] bg-no-repeat pr-10">
        {choices.map((c) => <option value={c} selected={c === selected}>{c}</option>)}
      </select>
    </div>
    <button type="submit" class="btn btn-gold w-full !min-h-14 text-[0.85rem]">
      <span data-label>Book Consultation</span>
      <Icon name="arrow" size={18} />
    </button>
    <p class="text-center text-xs text-muted">By submitting, you agree to our privacy policy and terms of service.</p>
  </form>
</div>

<dialog id="thanks" class="m-auto w-[min(28rem,calc(100vw-2rem))] rounded-3xl border border-line bg-[#fffdf9] p-0 text-body shadow-2xl backdrop:bg-ink/60 backdrop:backdrop-blur-sm">
  <div class="bg-stone p-6 sm:p-7">
    <div class="flex items-center gap-4">
      <span class="grid h-12 w-12 shrink-0 place-items-center rounded-full bg-gold text-ink"><Icon name="check" size={24} /></span>
      <div>
        <h2 class="text-2xl">Thank You!</h2>
        <p class="text-sm text-muted">Your request has been received</p>
      </div>
    </div>
  </div>
  <div class="space-y-5 p-6 sm:p-7">
    <p class="text-[0.95rem] leading-relaxed">
      Our team will contact you (usually via phone or WhatsApp) within 24 hours to schedule your in-clinic consultation at{" "}
      <strong class="font-semibold text-ink">Skin Lab Aesthetics, DHA Phase 4, Lahore</strong>.
    </p>
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-muted">Need to reach us sooner?</p>
    <div class="grid gap-3 sm:grid-cols-2">
      <a href={site.whatsapp.link} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-loc="thank_you" class="btn btn-wa !min-h-12 !px-4"><Icon name="whatsapp" size={18} /> WhatsApp</a>
      <a href={telHref} data-track="phone_click" data-loc="thank_you" class="btn btn-ink !min-h-12 !px-4"><Icon name="phone" size={16} /> Call {site.primaryPhone}</a>
    </div>
    <form method="dialog" class="text-right">
      <button class="text-sm font-medium text-muted underline-offset-4 hover:text-ink hover:underline">Close</button>
    </form>
  </div>
</dialog>

<script>
  const form = document.getElementById("booking-form") as HTMLFormElement;
  const card = document.getElementById("booking")!;
  const errorBox = card.querySelector<HTMLElement>('[data-status="error"]')!;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const label = button.querySelector<HTMLElement>("[data-label]")!;
  const dialog = document.getElementById("thanks") as HTMLDialogElement;
  const initialTreatment = (form.elements.namedItem("treatment") as HTMLSelectElement).value;

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorBox.hidden = true;
    button.disabled = true;
    label.textContent = "Submitting...";
    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
    try {
      // Same payload the live site sends to GoHighLevel.
      const res = await fetch(form.dataset.endpoint!, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: data.name,
          email: data.email,
          phone: data.phone,
          treatment: data.treatment,
          slug: form.dataset.slug,
          location: "Lahore",
          clinic: form.dataset.clinic,
          source: "Website Form",
          page_url: window.location.href,
          timestamp: new Date().toISOString(),
        }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const w = window as any;
      w.dataLayer = w.dataLayer || [];
      w.dataLayer.push({ event: "form_submit", formSlug: form.dataset.slug, formTreatment: data.treatment });
      form.reset();
      (form.elements.namedItem("treatment") as HTMLSelectElement).value = initialTreatment;
      dialog.showModal();
    } catch (err) {
      console.error("Form submission error:", err);
      errorBox.hidden = false;
    } finally {
      button.disabled = false;
      label.textContent = "Book Consultation";
    }
  });
  dialog.addEventListener("click", (e) => { if (e.target === dialog) dialog.close(); });

  // "Book X" buttons elsewhere on the page pre-select X in the form.
  document.addEventListener("click", (e) => {
    const link = (e.target as HTMLElement).closest<HTMLElement>("[data-treatment]");
    if (!link) return;
    const select = form.elements.namedItem("treatment") as HTMLSelectElement;
    if ([...select.options].some((o) => o.value === link.dataset.treatment)) select.value = link.dataset.treatment!;
  });
</script>
