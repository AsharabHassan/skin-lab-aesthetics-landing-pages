---
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
interface Props { title?: string; faqs: { question: string; answer: string }[] }
const { title, faqs } = Astro.props;
---
{faqs.length > 0 && (
  <section id="faq" class="border-t border-line bg-stone py-20 md:py-28">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <SectionHead title={title || "Common Questions"} eyebrow="Patient Resources" align="left" />
      </div>
      <div class="divide-y divide-line border-y border-line">
        {faqs.map((f, i) => (
          <details class="group" open={i === 0}>
            <summary class="flex items-start justify-between gap-6 py-6 text-left">
              <span class="font-serif text-[1.2rem] leading-snug text-ink group-open:text-gold-deep md:text-[1.3rem]">{f.question}</span>
              <span class="chev mt-0.5 grid h-8 w-8 shrink-0 place-items-center rounded-full border border-line text-gold-deep transition-transform duration-300"><Icon name="plus" size={16} /></span>
            </summary>
            <p class="-mt-1 pb-7 pr-12 text-[1rem] leading-relaxed">{f.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
