---
import Icon from "./Icon.astro";
import { site, pages, pageOrder, footerLabels } from "../data/site";
import { treatmentPages, treatmentOrder, shortLabels } from "../data/treatments";
---
<footer class="bg-[#0e0c0b] pb-10 pt-16 text-[#a89f92] md:pt-20">
  <div class="wrap">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <img src="/images/sla-logo-trim.png" alt={site.brandName} width="864" height="240" loading="lazy" class="h-12 w-auto" />
        <p class="mt-6 max-w-sm text-sm leading-relaxed">{site.footerCopy}</p>
        <div class="mt-6 space-y-1.5">
          {site.phones.map((p) => (
            <a href={`tel:${p.replace(/\s+/g, "")}`} data-track="phone_click" data-loc="footer" class="flex items-center gap-2 text-sm font-semibold tracking-wider text-gold-light hover:text-ivory"><Icon name="phone" size={14} /> {p}</a>
          ))}
        </div>
      </div>
      <div>
        <h2 class="font-sans text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-gold-light">Aesthetics</h2>
        <ul class="mt-6 space-y-3 text-sm">
          <li><a href="/" class="hover:text-ivory">Aesthetic Clinic</a></li>
          {treatmentOrder.map((s) => <li><a href={treatmentPages[s].route} class="hover:text-ivory">{shortLabels[s]}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="font-sans text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-gold-light">Dermatology</h2>
        <ul class="mt-6 space-y-3 text-sm">
          {pageOrder.map((s) => <li><a href={pages[s].route} class="hover:text-ivory">{footerLabels[s]}</a></li>)}
        </ul>
      </div>
      <div>
        <h2 class="font-sans text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-gold-light">Visit Us</h2>
        <p class="mt-6 text-sm leading-relaxed text-[#d8d0c4]">{site.address.full}</p>
        <p class="mt-3 text-xs">{site.hours.weekdays}</p>
        <p class="text-xs">{site.hours.sunday}</p>
        <a href={site.whatsapp.link} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-loc="footer" class="mt-6 inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-gold-light hover:text-ivory">
          WhatsApp {site.whatsapp.display} <Icon name="arrow" size={14} />
        </a>
        <div class="mt-6 flex gap-3">
          <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="grid h-10 w-10 place-items-center rounded-full border border-white/15 hover:border-gold-light hover:text-ivory"><Icon name="instagram" size={18} /></a>
          <a href={site.social.facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="grid h-10 w-10 place-items-center rounded-full border border-white/15 hover:border-gold-light hover:text-ivory"><Icon name="facebook" size={18} /></a>
        </div>
      </div>
    </div>
    <div class="mt-14 flex flex-col gap-2 border-t border-white/10 pt-8 text-[0.7rem] uppercase tracking-[0.18em] md:flex-row md:items-center md:justify-between">
      <span>© {new Date().getFullYear()} {site.brandName}, {site.address.city}</span>
      <span>{site.tagline}</span>
    </div>
  </div>
</footer>
