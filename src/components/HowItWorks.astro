---
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
import { steps as defaultSteps } from "../data/site";
interface Props {
  title?: string;
  lead?: string;
  items?: { title: string; body: string; tag?: string }[];
  note?: string;
  cta?: string;
}
const {
  title = "Your Simple Path to Expert Skincare Advice",
  lead = "Ready to take the first step? Booking and attending your In Clinic consultation is straightforward:",
  items = defaultSteps,
  note,
  cta = "Discuss Your Treatment Areas — Book Now",
} = Astro.props;
const n = items.length;
---
<section class="border-t border-line py-20 md:py-28">
  <div class="wrap">
    <SectionHead title={title} eyebrow="How It Works" lead={lead} />
    <ol class:list={["relative grid gap-4 lg:gap-0", n === 4 ? "md:grid-cols-2 lg:grid-cols-4" : n === 3 ? "md:grid-cols-3" : "mx-auto max-w-2xl"]}>
      {n > 1 && <div aria-hidden="true" class="absolute left-0 right-0 top-[2.1rem] hidden h-px bg-line lg:block"></div>}
      {items.map((s, i) => (
        <li class="reveal relative lg:px-6 lg:first:pl-0 lg:last:pr-0">
          <div class:list={["card h-full p-6", n > 1 && "lg:border-0 lg:bg-transparent lg:p-0"]}>
            <span class="relative z-10 grid h-[4.2rem] w-[4.2rem] place-items-center rounded-full border border-gold/50 bg-ivory font-serif text-2xl text-gold-deep">{i + 1}</span>
            <p class="mt-5 text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-muted">Step {i + 1}</p>
            <h3 class="mt-1.5 text-xl">{s.title}</h3>
            <p class="mt-3 text-[0.97rem] leading-relaxed">{s.body}</p>
            {s.tag && <p class="mt-4 inline-flex rounded-full bg-stone px-3.5 py-1.5 text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-gold-deep">{s.tag}</p>}
          </div>
        </li>
      ))}
    </ol>
    {note && <p class="mt-10 text-center text-[0.8rem] font-semibold uppercase tracking-[0.18em] text-muted">{note}</p>}
    <div class="mt-14 text-center">
      <a href="#booking" class="btn btn-gold">{cta} <Icon name="arrow" size={18} /></a>
    </div>
  </div>
</section>
