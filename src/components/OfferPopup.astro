---
// Laser package offer shown once per visitor (first visit), 3s after load.
// Closes on ✕, Esc or a click outside; the button scrolls to the booking form.
import Icon from "./Icon.astro";
---
<dialog id="offer-popup" aria-label="Laser hair removal package offer" class="m-auto w-[min(30rem,calc(100vw-2rem),calc((100dvh-9rem)*0.845))] overflow-visible rounded-3xl border border-line bg-[#fffdf9] p-0 text-body shadow-2xl backdrop:bg-ink/60 backdrop:backdrop-blur-sm">
  <div class="absolute -right-3 -top-3 z-10">
    <button type="button" data-close aria-label="Close offer" class="grid h-10 w-10 place-items-center rounded-full border border-line bg-ivory text-ink shadow-lg hover:bg-stone">
      <Icon name="close" size={18} />
    </button>
  </div>
  <img
    src="/images/offers/laser-offer.webp"
    alt="Laser hair removal packages: Face Laser Package, 8 sessions, now Rs 32,000 (was Rs 40,000). Full Body Laser, 6 sessions, now Rs 110,000 (was Rs 150,000). Limited time offer."
    width="1000" height="1183" fetchpriority="low" decoding="async"
    class="block h-auto w-full rounded-t-3xl"
  />
  <div class="p-4 sm:p-5">
    <a href="#booking" data-treatment="Laser Hair Removal" data-track="offer_click" data-loc="laser_popup" class="btn btn-gold w-full">
      Book a Consultation <Icon name="arrow" size={18} />
    </a>
  </div>
</dialog>

<script>
  const popup = document.getElementById("offer-popup") as HTMLDialogElement;
  const KEY = "sla_laser_offer_seen";
  let seen = false;
  try { seen = localStorage.getItem(KEY) === "1"; } catch {}

  if (!seen) {
    setTimeout(() => {
      // Don't interrupt someone who is already filling in the form.
      if (document.getElementById("booking-form")?.contains(document.activeElement)) return;
      popup.showModal();
      try { localStorage.setItem(KEY, "1"); } catch {}
    }, 3000);
  }

  // Plain button, not <form method="dialog">: a dialog form fires a submit event GTM counts as a form submission.
  popup.querySelector("[data-close]")!.addEventListener("click", () => popup.close());
  // Click on the backdrop (outside the card) closes it.
  popup.addEventListener("click", (e) => { if (e.target === popup) popup.close(); });
  // Close first so the page can scroll to the form.
  popup.querySelector('a[href="#booking"]')!.addEventListener("click", () => popup.close());
</script>
