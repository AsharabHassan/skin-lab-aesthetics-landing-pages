---
import SectionHead from "./SectionHead.astro";
interface Props { data: { sectionTitle: string; points: { title: string; text: string }[] } }
const { data } = Astro.props;
const n = data.points.length;
---
<section class="border-t border-line bg-stone py-20 md:py-28">
  <div class="wrap">
    <SectionHead title={data.sectionTitle} eyebrow="The Gold Standard" />
    <ol class:list={["grid gap-px overflow-hidden rounded-[1.25rem] border border-line bg-line", n === 2 || n === 4 ? "sm:grid-cols-2" : "sm:grid-cols-2 lg:grid-cols-3", n === 4 && "lg:grid-cols-4"]}>
      {data.points.map((p, i) => (
        <li class="reveal bg-[#fffdf9] p-7 md:p-9">
          <span class="font-serif text-4xl italic leading-none text-gold">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="mt-5 text-xl">{p.title}</h3>
          <p class="mt-3 text-[0.97rem] leading-relaxed">{p.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
