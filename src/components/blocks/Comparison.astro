---
// Side-by-side comparison table; the first option (ours) is highlighted. Scrolls sideways on phones.
import SectionHead from "../SectionHead.astro";
interface Props { id?: string; tone: string; eyebrow: string; title: string; columns: string[]; rows: { label: string; cells: string[] }[] }
const { id, tone, eyebrow, title, columns, rows } = Astro.props;
---
<section id={id} class:list={["scroll-mt-24 py-20 md:py-28", tone === "stone" && "border-t border-line bg-stone"]}>
  <div class="wrap">
    <SectionHead title={title} eyebrow={eyebrow} />
    <div class="reveal -mx-5 overflow-x-auto px-5 pb-2 md:mx-0 md:px-0">
      <table class="w-full min-w-[52rem] border-separate border-spacing-0 overflow-hidden rounded-[1.25rem] border border-line bg-[#fffdf9] text-left text-[0.93rem] leading-relaxed">
        <thead>
          <tr>
            <th scope="col" class="w-[15%] border-b border-line p-5 text-[0.7rem] font-semibold uppercase tracking-[0.18em] text-muted">Feature</th>
            {columns.map((c, i) => (
              <th scope="col" class:list={["border-b p-5 font-serif text-[1.08rem] font-medium leading-snug", i === 0 ? "border-gold/40 bg-ink text-ivory" : "border-line text-ink"]}>{c}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((r, ri) => (
            <tr>
              <th scope="row" class:list={["p-5 align-top text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-gold-deep", ri < rows.length - 1 && "border-b border-line"]}>{r.label}</th>
              {r.cells.map((c, i) => (
                <td class:list={["p-5 align-top", i === 0 ? "bg-[#221d17] font-medium text-[#efe6d6]" : "text-body", ri < rows.length - 1 && (i === 0 ? "border-b border-white/10" : "border-b border-line")]}>{c}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-center text-xs text-muted md:hidden">Swipe to compare →</p>
  </div>
</section>
