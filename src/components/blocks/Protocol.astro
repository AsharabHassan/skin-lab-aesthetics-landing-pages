---
// Dark signature band: a named multi-step protocol, with optional explainer, offer and note.
import SectionHead from "../SectionHead.astro";
import Icon from "../Icon.astro";
interface Props {
  id?: string; eyebrow: string; title: string; lead?: string;
  explainer?: { title: string; text: string }; steps: { title: string; text: string }[];
  note?: string; offer?: { badge: string; title: string; text: string }; cta?: string;
}
const { id, eyebrow, title, lead, explainer, steps, note, offer, cta } = Astro.props;
const cols = steps.length === 4 ? "sm:grid-cols-2 lg:grid-cols-4" : "md:grid-cols-3";
---
<section id={id} class="on-dark relative scroll-mt-24 overflow-hidden bg-ink py-20 text-[#d8d0c4] md:py-28">
  <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-0 h-[30rem] w-[60rem] -translate-x-1/2 rounded-full bg-[radial-gradient(ellipse,rgba(184,146,58,.18),transparent_65%)]"></div>
  <div class="wrap relative">
    <div class="[&_h2]:text-ivory">
      <SectionHead title={title} eyebrow={eyebrow} lead={lead} />
    </div>

    {(explainer || offer) && (
      <div class:list={["mb-8 grid gap-5", explainer && offer && "lg:grid-cols-2"]}>
        {explainer && (
          <div class="reveal rounded-[1.25rem] border border-white/10 bg-white/[0.04] p-7 md:p-8">
            <h3 class="text-[1.45rem] leading-snug text-ivory">{explainer.title}</h3>
            <p class="mt-3 leading-relaxed">{explainer.text}</p>
          </div>
        )}
        {offer && (
          <div class="reveal flex flex-col items-start justify-between gap-6 rounded-[1.25rem] border border-gold/60 bg-gradient-to-br from-[#2a2319] to-[#16130f] p-7 md:flex-row md:items-center md:p-9">
            <div>
              <span class="inline-flex items-center gap-2 rounded-full bg-gold px-3.5 py-1.5 text-[0.66rem] font-bold uppercase tracking-[0.2em] text-ink"><Icon name="spark" size={14} /> {offer.badge}</span>
              <p class="mt-4 font-serif text-[1.9rem] leading-tight text-ivory md:text-[2.3rem]">{offer.title}</p>
              <p class="mt-2 text-[1rem] text-gold-light">{offer.text}</p>
            </div>
            {cta && <a href="#booking" class="btn btn-gold shrink-0">{cta} <Icon name="arrow" size={18} /></a>}
          </div>
        )}
      </div>
    )}

    <ol class:list={["grid gap-5", cols]}>
      {steps.map((s, i) => (
        <li class:list={["reveal rounded-[1.25rem] p-7 md:p-8", i === 0 ? "border border-gold/50 bg-gradient-to-br from-[#221d17] to-[#16130f]" : "border border-white/10 bg-white/[0.03]"]}>
          <p class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-gold-light">Step {i + 1}</p>
          <h3 class="mt-3 text-[1.55rem] leading-tight text-ivory">{s.title}</h3>
          <p class="mt-3 leading-relaxed">{s.text}</p>
        </li>
      ))}
    </ol>

    {note && <p class="reveal mx-auto mt-10 max-w-3xl text-center font-serif text-[1.25rem] italic leading-relaxed text-ivory md:text-[1.4rem]">{note}</p>}
    {cta && !offer && <div class="mt-10 text-center"><a href="#booking" class="btn btn-gold">{cta} <Icon name="arrow" size={18} /></a></div>}
  </div>
</section>
