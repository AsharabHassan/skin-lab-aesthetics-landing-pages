---
// Detailed treatment cards: description, "what it feels like", benefit lists and price.
import SectionHead from "../SectionHead.astro";
import Icon from "../Icon.astro";
interface Item {
  title: string; price?: string; paras: string[]; feels?: string;
  bullets?: string[]; bulletsLabel?: string; groups?: { label: string; list: string[] }[];
}
interface Props { id?: string; tone: string; eyebrow: string; title: string; lead?: string; items: Item[]; outro?: string; cta?: string }
const { id, tone, eyebrow, title, lead, items, outro, cta } = Astro.props;
// "Pain-free and comfortable: The procedure…" → bold lead-in + text
const kv = (b: string) => { const i = b.indexOf(":"); return i > 0 && i < 60 ? [b.slice(0, i), b.slice(i + 1)] : ["", b]; };
// "HydraFacial: The Ultimate Cleanse…" → name + promise
const split = (t: string) => { const i = t.indexOf(":"); return i > 0 && i < t.length - 1 ? [t.slice(0, i), t.slice(i + 1).trim()] : [t.replace(/:$/, ""), ""]; };
const compact = items.every((it) => !it.bullets && !it.groups && !it.feels);
---
<section id={id} class:list={["scroll-mt-24 py-20 md:py-28", tone === "stone" && "border-t border-line bg-stone"]}>
  <div class="wrap">
    <SectionHead title={title} eyebrow={eyebrow} lead={lead} />

    {compact ? (
      <div class:list={["grid gap-5", items.length === 1 ? "mx-auto max-w-3xl" : "md:grid-cols-2 lg:grid-cols-3"]}>
        {items.map((it) => (
          <article class="card reveal flex flex-col p-7 md:p-8">
            <h3 class="text-[1.45rem] leading-snug">{split(it.title)[0]}</h3>
            {it.price && <p class="mt-2 font-serif text-lg text-gold-deep">{it.price}</p>}
            <div class="mt-4 space-y-3 text-[0.97rem] leading-relaxed">
              {it.paras.map((p) => { const [k, v] = kv(p); return <p>{k && <strong class="font-semibold text-ink">{k}:</strong>}{v}</p>; })}
            </div>
            <a href="#booking" class="group mt-auto inline-flex items-center gap-2 pt-6 text-[0.75rem] font-semibold uppercase tracking-[0.18em] text-gold-deep hover:text-ink">
              Book Consultation <Icon name="arrow" size={16} class="transition-transform group-hover:translate-x-1" />
            </a>
          </article>
        ))}
      </div>
    ) : (
      <div class="space-y-6">
        {items.map((it, i) => {
          const [name, promise] = split(it.title);
          return (
            <article class="card reveal grid gap-8 p-7 md:p-10 lg:grid-cols-[1.1fr_1fr] lg:gap-12">
              <div>
                <p class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-gold-deep"><span class="font-serif text-base italic tracking-normal text-gold">{String(i + 1).padStart(2, "0")}</span> · {name}</p>
                <h3 class="mt-3 text-[1.7rem] leading-tight md:text-[2rem]">{promise || name}</h3>
                {it.price && <p class="mt-3 inline-flex rounded-full bg-stone px-4 py-1.5 font-serif text-lg text-ink">{it.price}</p>}
                <div class="mt-5 space-y-4 text-[1rem] leading-relaxed">
                  {it.paras.map((p) => <p>{p}</p>)}
                </div>
                {it.feels && (
                  <div class="mt-6 rounded-2xl border border-line bg-ivory p-5">
                    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-gold-deep">What it Feels Like</p>
                    <p class="mt-2 text-[0.97rem] leading-relaxed">{it.feels}</p>
                  </div>
                )}
              </div>
              <div class="space-y-7 lg:border-l lg:border-line lg:pl-12">
                {it.groups?.map((g) => (
                  <div>
                    <p class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-muted">{g.label}</p>
                    <ul class="check-list mt-3 space-y-2.5 text-[0.97rem] leading-relaxed">
                      {g.list.map((b) => { const [k, v] = kv(b); return <li>{k && <strong class="font-semibold text-ink">{k}:</strong>}{v}</li>; })}
                    </ul>
                  </div>
                ))}
                {it.bullets && (
                  <div>
                    <p class="text-[0.7rem] font-semibold uppercase tracking-[0.2em] text-muted">{(it.bulletsLabel ?? "Benefits").replace(/:$/, "")}</p>
                    <ul class="check-list mt-3 space-y-2.5 text-[0.97rem] leading-relaxed">
                      {it.bullets.map((b) => { const [k, v] = kv(b); return <li>{k && <strong class="font-semibold text-ink">{k}:</strong>}{v}</li>; })}
                    </ul>
                  </div>
                )}
                <a href="#booking" data-treatment={name} class="btn btn-ghost !min-h-12">Book Consultation <Icon name="arrow" size={16} /></a>
              </div>
            </article>
          );
        })}
      </div>
    )}

    {outro && <p class="reveal mx-auto mt-10 max-w-3xl text-center font-serif text-[1.25rem] italic leading-relaxed text-ink-2 md:text-[1.4rem]">{outro}</p>}
    {cta && <div class="mt-10 text-center"><a href="#booking" class="btn btn-gold">{cta} <Icon name="arrow" size={18} /></a></div>}
  </div>
</section>
