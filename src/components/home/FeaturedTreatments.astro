---
import SectionHead from "../SectionHead.astro";
import Icon from "../Icon.astro";
import { featured } from "../../data/home";
---
<section id="signature" class="py-20 md:py-28">
  <div class="wrap">
    <SectionHead
      title="Our Most-Requested Aesthetic Treatments"
      eyebrow="Signature Treatments"
      lead="Our five most-requested treatments, each planned by a doctor."
    />

    <nav aria-label="Signature treatments" class="no-scrollbar -mx-5 -mt-4 mb-14 flex gap-2 overflow-x-auto px-5 md:mx-0 md:flex-wrap md:justify-center md:px-0">
      {featured.map((f) => (
        <a href={`#${f.id}`} class="shrink-0 rounded-full border border-line bg-[#fffdf9] px-4 py-2 text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-ink-2 transition-colors hover:border-gold hover:text-gold-deep">{f.title}</a>
      ))}
    </nav>

    <div class="space-y-16 md:space-y-24">
      {featured.map((f, i) => (
        <article id={f.id} class="reveal grid scroll-mt-24 items-center gap-8 lg:grid-cols-2 lg:gap-16">
          <div class:list={["relative", i % 2 === 1 && "lg:order-2"]}>
            <figure class:list={["relative h-80 overflow-hidden rounded-[1.5rem] border border-line sm:h-[26rem] lg:h-[32rem]", f.photo.cutout ? "bg-stone" : "bg-sand"]}>
              <img
                src={f.photo.src}
                alt={`${f.title} at Skin Lab Aesthetics, Lahore`}
                loading="lazy"
                decoding="async"
                class:list={["absolute inset-0 h-full w-full", f.photo.cutout ? "object-contain p-6" : "object-cover"]}
                style={`object-position:${f.photo.pos}`}
              />
              <span class="absolute left-4 top-4 rounded-full bg-ivory/90 px-3 py-1.5 font-serif text-sm italic text-gold-deep backdrop-blur">{String(i + 1).padStart(2, "0")}</span>
            </figure>
            {f.result && (
              <figure class:list={["absolute -bottom-6 w-40 rounded-2xl border border-line bg-[#fffdf9] p-1.5 shadow-[0_20px_40px_-24px_rgba(20,18,16,.5)] sm:w-48", i % 2 === 1 ? "-left-2 sm:-left-4" : "-right-2 sm:-right-4"]}>
                <img src={f.result} alt="" aria-hidden="true" loading="lazy" decoding="async" class="aspect-square w-full rounded-xl object-cover" />
                <figcaption class="px-1 pb-0.5 pt-1.5 text-center text-[0.62rem] font-semibold uppercase tracking-[0.16em] text-gold-deep">Real Result</figcaption>
              </figure>
            )}
          </div>

          <div>
            <p class="eyebrow">{f.eyebrow}</p>
            <h3 class="mt-3 text-[2rem] font-medium sm:text-[2.5rem]">{f.title}</h3>
            <p class="mt-4 text-[1.03rem] leading-relaxed">{f.intro}</p>

            <p class="mt-6 text-[0.68rem] font-semibold uppercase tracking-[0.2em] text-muted">{f.listLabel}</p>
            <ul class="mt-2.5 flex flex-wrap gap-2">
              {f.list.map((x) => <li class="rounded-full bg-stone px-3.5 py-1.5 text-sm text-ink-2">{x}</li>)}
            </ul>

            <dl class="mt-7 grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-3">
              {f.facts.map((x) => (
                <div class="bg-[#fffdf9] p-4">
                  <dt class="text-[0.64rem] font-semibold uppercase tracking-[0.18em] text-gold-deep">{x.label}</dt>
                  <dd class="mt-1 text-[0.92rem] leading-snug text-ink">{x.value}</dd>
                </div>
              ))}
            </dl>

            <div class="mt-7 flex flex-col gap-5 border-t border-line pt-6 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="font-serif text-2xl text-ink">{f.price}</p>
                {f.priceNote && <p class="mt-1 max-w-sm text-xs leading-relaxed text-muted">{f.priceNote}</p>}
              </div>
              <a href="#booking" data-treatment={f.formOption} class="btn btn-gold !min-h-12 shrink-0 !px-5">Book {f.title.replace(" Treatments", "").replace(" Treatment", "")} <Icon name="arrow" size={16} /></a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
