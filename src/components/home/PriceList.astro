---
import SectionHead from "../SectionHead.astro";
import Icon from "../Icon.astro";
import { prices } from "../../data/home";
import { site } from "../../data/site";
---
<section id="prices" class="py-20 md:py-28">
  <div class="wrap">
    <SectionHead title="Transparent Prices" eyebrow="Popular Treatments" lead="Your exact price is confirmed at consultation." />
    <div class="grid gap-5 lg:grid-cols-3">
      {prices.map((g) => (
        <div class="card reveal p-6 md:p-8">
          <h3 class="text-2xl">{g.group}</h3>
          <div class="hairline my-5"></div>
          <dl class="space-y-3.5">
            {g.rows.map((r) => (
              <div class="flex items-baseline gap-3">
                <dt class="text-[0.97rem] text-ink-2">
                  {r.name}
                  {r.note && <span class="mt-0.5 block text-xs font-semibold uppercase tracking-[0.12em] text-gold-deep">{r.note}</span>}
                </dt>
                <span aria-hidden="true" class="mb-1 flex-1 border-b border-dotted border-sand"></span>
                <dd class="shrink-0 font-serif text-lg text-ink">{r.price}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>
    <div class="reveal mt-8 flex flex-col items-start justify-between gap-5 rounded-[1.25rem] border border-line bg-stone p-6 md:flex-row md:items-center md:p-8">
      <div>

        <p class="text-sm text-muted">Male laser hair removal carries a 50% surcharge. Offer prices may change.</p>
      </div>
      <a href={site.whatsapp.link} target="_blank" rel="noopener noreferrer" data-track="whatsapp_click" data-loc="prices" class="btn btn-wa shrink-0"><Icon name="whatsapp" size={18} /> Ask on WhatsApp</a>
    </div>
  </div>
</section>
