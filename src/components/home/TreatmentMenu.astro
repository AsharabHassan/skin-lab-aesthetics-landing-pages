---
import SectionHead from "../SectionHead.astro";
import Icon from "../Icon.astro";
import { treatments } from "../../data/home";
const [featured, ...rest] = treatments;
---
<section id="treatments" class="border-t border-line bg-stone py-20 md:py-28">
  <div class="wrap">
    <SectionHead
      title="All Aesthetic Treatments in Lahore"
      eyebrow="Full Treatment Menu"
      lead="Every treatment planned by our doctors around your skin and goals."
    />
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {[featured, ...rest].map((t, i) => (
        <article class:list={["card reveal group flex flex-col overflow-hidden", (i === 0 || t.links) && "lg:col-span-2 lg:flex-row"]}>
          <div class:list={["relative h-56 overflow-hidden bg-sand", (i === 0 || t.links) && "lg:h-auto lg:w-1/2"]}>
            <img src={t.photo} alt="" loading="lazy" decoding="async" width="600" height="1050" class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" style={`object-position:${t.pos}`} />
            {t.from && <span class="absolute left-4 top-4 rounded-full bg-ivory/90 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-ink backdrop-blur">From {t.from}</span>}
          </div>
          <div class:list={["flex flex-1 flex-col p-6 md:p-7", i === 0 && "lg:p-10"]}>
            <h3 class:list={["text-[1.5rem]", i === 0 && "lg:text-[2rem]"]}>{t.title}</h3>
            <p class="mt-3 text-[0.97rem] leading-relaxed">{t.text}</p>
            {t.items.length > 0 && (
              <ul class="dash-list mt-5 space-y-1.5 text-[0.93rem] text-ink-2">
                {t.items.map((it) => t.itemLinks?.[it]
                  ? <li><a href={t.itemLinks[it]} class="font-medium text-ink underline decoration-line underline-offset-4 hover:text-gold-deep hover:decoration-gold">{it}</a></li>
                  : <li>{it}</li>)}
              </ul>
            )}
            {t.links && (
              <ul class="mt-5 grid grid-cols-1 gap-x-6 gap-y-2 text-[0.93rem] sm:grid-cols-2 md:grid-cols-1">
                {t.links.map((l) => (
                  <li><a href={l.href} class="group/link inline-flex items-center gap-1.5 font-medium text-ink underline decoration-line underline-offset-4 hover:text-gold-deep hover:decoration-gold">{l.label} <Icon name="arrow" size={14} class="transition-transform group-hover/link:translate-x-0.5" /></a></li>
                ))}
              </ul>
            )}
            <div class="mt-auto flex flex-wrap items-center gap-x-6 gap-y-2 pt-6">
              {t.href && (
                <a href={t.href} class="inline-flex items-center gap-2 text-[0.75rem] font-semibold uppercase tracking-[0.18em] text-ink underline decoration-gold underline-offset-4 hover:text-gold-deep">
                  View Treatment <Icon name="arrow" size={16} />
                </a>
              )}
              <a href="#booking" class="inline-flex items-center gap-2 text-[0.75rem] font-semibold uppercase tracking-[0.18em] text-gold-deep hover:text-ink">
                Book Consultation <Icon name="arrow" size={16} />
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
