---
import Icon from "../Icon.astro";
import { usps } from "../../data/home";
---
<section aria-label="Why patients choose us" class="border-y border-line bg-[#fffdf9]">
  <div class="wrap">
    <ul class="no-scrollbar -mx-5 flex gap-8 overflow-x-auto px-5 py-5 md:mx-0 md:grid md:grid-cols-3 md:gap-x-10 md:gap-y-4 md:px-0 lg:grid-cols-6">
      {usps.map((u) => (
        <li class="flex shrink-0 items-center gap-2.5 text-[0.78rem] font-semibold uppercase tracking-[0.14em] text-ink-2">
          <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-stone text-gold-deep"><Icon name="check" size={14} /></span>
          {u}
        </li>
      ))}
    </ul>
  </div>
</section>
